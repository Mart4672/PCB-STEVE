			)
			(justify left bottom mirror)
		)
	)
	(gr_text "{dblquote}Did you ever hear the tragedy of Darth \nPlagueis The Wise? I thought not. It's \nnot a story the Jedi would tell you. It's \na Sith legend. Darth Plagueis was a \nDark Lord of the Sith, so powerful and \nso wise he could use the Force to \ninfluence the midichlorians to create \nlife…{dblquote}"
		(at 160.7 -13.2 0)
		(layer "B.SilkS")
