	(gr_text "{dblquote}I... am Steve{dblquote}"
		(at 155.05 59.4 0)
		(layer "B.SilkS")
		(uuid "2b29407c-4f42-4857-b22e-d47b1f132a99")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
			(justify left bottom mirror)
		)
	)
	(gr_text "{dblquote}He had such a knowledge of the dark side that he could even keep \nthe ones he cared about from dying. The dark side of the Force is \na pathway to many abilities some consider to be unnatural. He \nbecame so powerful… the only thing he was afraid of was losing \nhis power, which eventually, of course, he did. Unfortunately, \nhe taught his apprentice everything he knew, then his \napprentice killed him in his sleep. Ironic. He could save \nothers from death, but not himself.{dblquote}"
		(at 165 112 0)
		(layer "B.SilkS")
		(uuid "2eafc2cd-6220-47d9-b43d-39c3a6389c0e")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
			(justify left bottom mirror)
		)
	)
	(gr_text "{dblquote}Did you ever hear the tragedy of Darth Plagueis The Wise? \nI thought not. It's not a story the Jedi would tell you. It's \na Sith legend. Darth Plagueis was a Dark Lord of the Sith, \nso powerful and so wise he could use the Force to influence \nthe midichlorians to create life…{dblquote}"
		(at 165 71 0)
		(layer "B.SilkS")
		(uuid "9909e1c3-3d09-48f1-82b4-8663cb3db6a9")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
			(justify left bottom mirror)
		)
	)
