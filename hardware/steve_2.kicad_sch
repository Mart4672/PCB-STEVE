	(text_box "LED Color | Typical Vf\n--------------\nRed         1.8-2.1\nAmber       2.0-2.2\nOrange      1.9-2.2\nYellow      1.9-2.2\nGreen       2.0-3.1\nBlue        3.0-3.7\nWhite       3.0-3.4"
