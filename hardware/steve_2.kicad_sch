	)
	(text_box "The W25Q128JVSIQ is a SOIC-8 5x5mm part.\nThe W25Q128JVPIQ is a WSON-8 6x5mm part.\nKiCad has footprints for both"
		(exclude_from_sim no)
		(at 220.98 119.38 0)
		(size 48.26 8.89)
		(stroke
			(width 0)
			(type default)
		)
		(fill
