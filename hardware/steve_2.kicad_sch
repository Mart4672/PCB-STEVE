			(justify left top)
		)
		(uuid "8d945703-44f5-4b5b-ad54-800f1e5168a8")
	)
	(text_box "The voltage divider ratio is (20k / (20K + 150k)) = 0.117647\nThe output voltage should be 0.6V / 0.117 = 5.1V"
