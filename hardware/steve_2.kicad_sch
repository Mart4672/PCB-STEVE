		(uuid "e5989653-e81f-41ad-9b8e-ef7365f765ad")
	)
	(text_box "R_LED = (Vs - Vf) / If\nHighest R scenario: \nR_LED = (3.3V - Vf) / 0.020A\n2V scenario: \nR_LED = (2.0V - Vf) / 0.020A\n\n"
